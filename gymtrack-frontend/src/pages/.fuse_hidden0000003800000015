import { useState, useEffect } from 'react'
import { listarNotificaciones, crearNotificacion, archivarNotificacion } from '../services/notificacionService'

interface Notificacion {
  id: number
  titulo: string
  mensaje: string
  tipo: string
  destinatario: string
  socioId?: number | null
  fechaCreacion: string
  activa: boolean
}

const VACIO = { titulo: '', mensaje: '', tipo: 'INFO', destinatario: 'TODOS', socioId: '' }

const TIPO_COLORES: Record<string, string> = {
  INFO:      'gt-badge gt-badge-blue',
  ALERTA:    'gt-badge gt-badge-yellow',
  URGENTE:   'gt-badge gt-badge-red',
  RECORDATORIO: 'gt-badge gt-badge-green',
}

export default function NotificacionesPage() {
  const [notifs, setNotifs]         = useState<Notificacion[]>([])
  const [form, setForm]             = useState(VACIO)
  const [error, setError]           = useState<string | null>(null)
  const [exito, setExito]           = useState<string | null>(null)
  const [creando, setCreando]       = useState(false)

  useEffect(() => { cargar() }, [])

  const cargar = async () => {
    try { setNotifs(await listarNotificaciones()) } catch {}
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!form.titulo || !form.mensaje) { setError('Título y mensaje son obligatorios'); return }
    setCreando(true)
    try {
      await crearNotificacion({
        ...form,
        socioId: form.socioId ? Number(form.socioId) : null,
      })
      setExito('Notificación enviada')
      setForm(VACIO)
      setError(null)
      cargar()
    } catch { setError('Error al enviar la notificación') }
    finally { setCreando(false) }
  }

  const handleArchivar = async (id: number) => {
    try { await archivarNotificacion(id); setExito('Notificación archivada'); cargar() }
    catch { setError('Error al archivar') }
  }

  return (
    <>
      <h1 className="gt-page-title">Notificaciones</h1>

      {exito && <div className="gt-alert gt-alert-success">{exito}<button onClick={() => setExito(null)} style={{ float: 'right', background: 'none', border: 'none', cursor: 'pointer' }}>✕</button></div>}
      {error && <div className="gt-alert gt-alert-error">{error}<button onClick={() => setError(null)} style={{ float: 'right', background: 'none', border: 'none', cursor: 'pointer' }}>✕</button></div>}

      {/* Formulario */}
      <div className="gt-card" style={{ marginBottom: 20 }}>
        <p className="gt-card-title">Nueva notificación</p>
        <form onSubmit={handleSubmit}>
          <div className="gt-form-grid">
            <div className="gt-form-group">
              <label className="gt-label">Título *</label>
              <input className="gt-input" value={form.titulo} onChange={e => setForm({ ...form, titulo: e.target.value })} placeholder="Ej: Clase cancelada" />
            </div>
            <div className="gt-form-group">
              <label className="gt-label">Tipo</label>
              <select className="gt-select" value={form.tipo} onChange={e => setForm({ ...form, tipo: e.target.value })}>
                <option value="INFO">ℹ️ Información</option>
                <option value="ALERTA">⚠️ Alerta</option>
                <option value="URGENTE">🚨 Urgente</option>
                <option value="RECORDATORIO">🔔 Recordatorio</option>
              </select>
            </div>
            <div className="gt-form-group">
              <label className="gt-label">Destinatario</label>
              <select className="gt-select" value={form.destinatario} onChange={e => setForm({ ...form, destinatario: e.target.value })}>
                <option value="TODOS">Todos los socios</option>
                <option value="SOCIO">Socio específico</option>
              </select>
            </div>
            {form.destinatario === 'SOCIO' && (
              <div className="gt-form-group">
                <label className="gt-label">ID del socio</label>
                <input className="gt-input" type="number" value={form.socioId} onChange={e => setForm({ ...form, socioId: e.target.value })} placeholder="ID numérico del socio" />
              </div>
            )}
            <div className="gt-form-group" style={{ gridColumn: '1 / -1' }}>
              <label className="gt-label">Mensaje *</label>
              <textarea className="gt-textarea" rows={3} value={form.mensaje} onChange={e => setForm({ ...form, mensaje: e.target.value })} placeholder="Contenido de la notificación..." />
            </div>
          </div>
          <button type="submit" className="gt-btn gt-btn-primary" disabled={creando}>
            {creando ? 'Enviando...' : '🔔 Enviar notificación'}
          </button>
        </form>
      </div>

      {/* Lista */}
      <div className="gt-card">
        <p className="gt-card-title">Notificaciones activas ({notifs.length})</p>
        {notifs.length === 0 ? (
          <div className="gt-empty">No hay notificaciones activas.</div>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
            {notifs.map(n => (
              <div key={n.id} style={{ border: '1px solid #E5E7EB', borderRadius: 8, padding: '12px 16px', display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                <div style={{ flex: 1 }}>
                  <div style={{ display: 'flex', gap: 8, alignItems: 'center', marginBottom: 4 }}>
                    <span className={TIPO_COLORES[n.tipo] || 'gt-badge gt-badge-gray'}>{n.tipo}</span>
                    <span className="gt-badge gt-badge-gray">{n.destinatario === 'TODOS' ? 'Todos' : `Socio #${n.socioId}`}</span>
                    <span style={{ fontSize: 12, color: '#9CA3AF' }}>{new Date(n.fechaCreacion).toLocaleString('es-AR')}</span>
                  </div>
                  <p style={{ fontWeight: 600, margin: '0 0 2px', fontSize: 14 }}>{n.titulo}</p>
                  <p style={{ margin: 0, fontSize: 13, color: '#4B5563' }}>{n.mensaje}</p>
                </div>
                <button className="gt-btn gt-btn-secondary" style={{ marginLeft: 16, flexShrink: 0 }} onClick={() => handleArchivar(n.id)}>
                  Archivar
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
    </>
  )
}
