import { useEffect, useState } from 'react'
import { useNavigate, useParams, useSearchParams } from 'react-router-dom'
import type { RutinaRequestDTO } from '../types/Rutina'
import { crearRutina, obtenerRutina, actualizarRutina, agregarEjercicio } from '../services/rutinaService'
import { useAuth } from '../context/AuthContext'
import { obtenerTodos, obtenerPorId } from '../services/socioService'
import type { Socio } from '../types/Socio'
import {
  PLANTILLAS,
  TREN_LABELS,
  OBJETIVO_LABELS,
  type TrenMuscular,
  type ObjetivoRutina,
  type RutinaPlantilla,
} from '../data/rutinaPlantillas'

export default function RutinaForm() {
  const { id } = useParams<{ id: string }>()
  const [searchParams] = useSearchParams()
  const navigate   = useNavigate()
  const { user }   = useAuth()

  const esAdmin   = user?.rol === 'ADMIN' || user?.rol === 'EMPLEADO'
  const esEdicion = Boolean(id)

  const socioIdAuth  = user?.socioId ?? null
  const socioIdParam = searchParams.get('socioId') ? Number(searchParams.get('socioId')) : null

  // ── Buscador de socio (solo ADMIN) ─────────────────────────────
  const [socios, setSocios]               = useState<Socio[]>([])
  const [busquedaSocio, setBusquedaSocio] = useState('')
  const [socioSeleccionado, setSocioSeleccionado] = useState<Socio | null>(null)
  const [mostrarBuscador, setMostrarBuscador]     = useState(false)
  const [socioIdInput, setSocioIdInput]   = useState<number | ''>(socioIdParam ?? '')

  const getSocioId = (): number | null =>
    esAdmin ? (socioSeleccionado?.id ?? (socioIdInput as number) || null) : socioIdAuth

  useEffect(() => {
    if (mostrarBuscador && socios.length === 0) {
      obtenerTodos().then(setSocios).catch(() => {})
    }
  }, [mostrarBuscador])

  const sociosFiltrados = busquedaSocio.length >= 1
    ? socios.filter(s => {
        const q = busquedaSocio.toLowerCase()
        return s.nombre.toLowerCase().includes(q) ||
               s.apellido.toLowerCase().includes(q) ||
               s.dni.includes(q)
      }).slice(0, 5)
    : []

  const seleccionarSocio = (s: Socio) => {
    setSocioSeleccionado(s)
    setSocioIdInput(s.id!)
    setBusquedaSocio(`${s.nombre} ${s.apellido}`)
    setMostrarBuscador(false)
  }

  // Auto-seleccionar socio si viene desde el perfil con ?socioId=X
  useEffect(() => {
    if (socioIdParam && esAdmin && !esEdicion) {
      obtenerPorId(socioIdParam)
        .then(s => seleccionarSocio(s))
        .catch(() => {})
    }
  }, [socioIdParam])

  // ── Plantillas ──────────────────────────────────────────────────
  const [mostrarPlantillas, setMostrarPlantillas] = useState(false)
  const [filtroTren, setFiltroTren]     = useState<TrenMuscular | ''>('')
  const [filtroObjetivo, setFiltroObjetivo] = useState<ObjetivoRutina | ''>('')
  const [plantillaSeleccionada, setPlantillaSeleccionada] = useState<RutinaPlantilla | null>(null)

  const plantillasFiltradas = PLANTILLAS.filter(p =>
    (!filtroTren    || p.trenMuscular === filtroTren) &&
    (!filtroObjetivo || p.objetivo     === filtroObjetivo)
  )

  const aplicarPlantilla = (p: RutinaPlantilla) => {
    setPlantillaSeleccionada(p)
    setNombre(p.nombre)
    setDescripcion(p.descripcion)
    setMostrarPlantillas(false)
  }

  // ── Formulario principal ────────────────────────────────────────
  const [nombre, setNombre]           = useState('')
  const [descripcion, setDescripcion] = useState('')
  const [error, setError]             = useState<string | null>(null)
  const [guardando, setGuardando]     = useState(false)
  const [progreso, setProgreso]       = useState<string | null>(null)

  useEffect(() => {
    if (!esEdicion || !id) return
    const sid = esAdmin ? socioIdParam : socioIdAuth
    if (!sid) return
    obtenerRutina(Number(id), sid)
      .then(r => { setNombre(r.nombre); setDescripcion(r.descripcion ?? '') })
      .catch(() => setError('No se pudo cargar la rutina'))
  }, [id])

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    const sid = getSocioId()
    if (!sid) { setError('Seleccioná o ingresá el ID del socio'); return }
    if (nombre.trim().length < 3) { setError('El nombre debe tener al menos 3 caracteres'); return }

    const datos: RutinaRequestDTO = { nombre: nombre.trim(), descripcion: descripcion.trim() }

    try {
      setGuardando(true)
      setError(null)

      if (esEdicion && id) {
        await actualizarRutina(Number(id), sid, datos)
        navigate(esAdmin ? `/rutinas/${id}?socioId=${sid}` : `/rutinas/${id}`)
        return
      }

      // Crear rutina nueva
      const nueva = await crearRutina(sid, datos)
      const rutinaId = nueva.id!

      // Si hay plantilla seleccionada, agregar sus ejercicios
      if (plantillaSeleccionada) {
        const total = plantillaSeleccionada.ejercicios.length
        for (let i = 0; i < total; i++) {
          const ej = plantillaSeleccionada.ejercicios[i]
          setProgreso(`Agregando ejercicios… (${i + 1}/${total})`)
          await agregarEjercicio(rutinaId, sid, {
            nombreEjercicio: ej.nombreEjercicio,
            series:          ej.series,
            repeticiones:    ej.repeticiones,
            descansoSeg:     ej.descansoSeg,
            notas:           ej.notas,
          })
        }
      }

      navigate(esAdmin ? `/rutinas/${rutinaId}?socioId=${sid}` : `/rutinas/${rutinaId}`)
    } catch {
      setError('Error al guardar la rutina')
    } finally {
      setGuardando(false)
      setProgreso(null)
    }
  }

  return (
    <>
      <div className="gt-section-header">
        <h1 className="gt-page-title" style={{ margin: 0 }}>
          {esEdicion ? 'Editar Rutina' : 'Nueva Rutina'}
        </h1>
      </div>

      {/* ── Buscador de socio (ADMIN) ── */}
      {esAdmin && !esEdicion && (
        <div className="gt-card" style={{ marginBottom: 16 }}>
          <p style={{ margin: '0 0 10px', fontWeight: 600, fontSize: 14 }}>
            👤 Socio destinatario
          </p>
          {socioSeleccionado ? (
            <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
              <span style={{ fontWeight: 700, color: '#2E75B6' }}>#{socioSeleccionado.id}</span>
              <span>{socioSeleccionado.nombre} {socioSeleccionado.apellido}</span>
              <span style={{ fontSize: 12, color: '#6B7280' }}>DNI {socioSeleccionado.dni}</span>
              <button
                type="button"
                className="gt-btn gt-btn-secondary"
                style={{ fontSize: 12, marginLeft: 'auto' }}
                onClick={() => { setSocioSeleccionado(null); setSocioIdInput(''); setBusquedaSocio('') }}
              >
                Cambiar
              </button>
            </div>
          ) : (
            <>
              <button
                type="button"
                className="gt-btn gt-btn-secondary"
                style={{ fontSize: 12 }}
                onClick={() => setMostrarBuscador(v => !v)}
              >
                🔍 {mostrarBuscador ? 'Cerrar buscador' : 'Buscar socio por nombre'}
              </button>

              {mostrarBuscador && (
                <div style={{ marginTop: 10 }}>
                  <input
                    className="gt-input"
                    placeholder="Nombre, apellido o DNI..."
                    value={busquedaSocio}
                    onChange={e => setBusquedaSocio(e.target.value)}
                    style={{ marginBottom: 6 }}
                  />
                  {sociosFiltrados.length > 0 && (
                    <div style={{ border: '1px solid #E5E7EB', borderRadius: 6, background: '#fff' }}>
                      {sociosFiltrados.map(s => (
                        <div
                          key={s.id}
                          onClick={() => seleccionarSocio(s)}
                          style={{ padding: '8px 12px', cursor: 'pointer', borderBottom: '1px solid #F3F4F6', display: 'flex', gap: 10 }}
                          onMouseEnter={e => (e.currentTarget.style.background = '#F0F9FF')}
                          onMouseLeave={e => (e.currentTarget.style.background = '#fff')}
                        >
                          <span style={{ fontWeight: 700, color: '#2E75B6' }}>#{s.id}</span>
                          <span>{s.nombre} {s.apellido}</span>
                          <span style={{ marginLeft: 'auto', fontSize: 12, color: '#6B7280' }}>DNI {s.dni}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {busquedaSocio.length > 0 && sociosFiltrados.length === 0 && (
                    <p style={{ fontSize: 12, color: '#6B7280', margin: '4px 0 0' }}>Sin resultados</p>
                  )}
                </div>
              )}

              {/* Fallback manual */}
              {!mostrarBuscador && (
                <div style={{ marginTop: 8, display: 'flex', alignItems: 'center', gap: 8 }}>
                  <span style={{ fontSize: 12, color: '#6B7280' }}>o ingresá el ID manualmente:</span>
                  <input
                    className="gt-input"
                    type="number"
                    value={socioIdInput}
                    onChange={e => setSocioIdInput(Number(e.target.value))}
                    placeholder="ID"
                    style={{ width: 80 }}
                  />
                </div>
              )}
            </>
          )}
        </div>
      )}

      {/* ── Selector de plantillas ── */}
      {!esEdicion && (
        <div style={{ marginBottom: 16 }}>
          <button
            type="button"
            className="gt-btn gt-btn-secondary"
            onClick={() => setMostrarPlantillas(v => !v)}
          >
            📋 {mostrarPlantillas ? 'Cerrar plantillas' : 'Crear desde plantilla'}
          </button>

          {plantillaSeleccionada && !mostrarPlantillas && (
            <span style={{ marginLeft: 12, fontSize: 13, color: '#16A34A', fontWeight: 600 }}>
              ✓ Plantilla: {plantillaSeleccionada.nombre} ({plantillaSeleccionada.ejercicios.length} ejercicios)
              <button
                type="button"
                onClick={() => setPlantillaSeleccionada(null)}
                style={{ marginLeft: 8, background: 'none', border: 'none', cursor: 'pointer', color: '#6B7280', fontSize: 12 }}
              >
                ✕ quitar
              </button>
            </span>
          )}

          {mostrarPlantillas && (
            <div style={{ marginTop: 12, padding: 16, background: '#F9FAFB', border: '1px solid #E5E7EB', borderRadius: 8 }}>
              {/* Filtros */}
              <div style={{ display: 'flex', gap: 10, marginBottom: 14, flexWrap: 'wrap' }}>
                <select
                  className="gt-select"
                  style={{ width: 'auto' }}
                  value={filtroTren}
                  onChange={e => setFiltroTren(e.target.value as TrenMuscular | '')}
                >
                  <option value="">Todos los trenes</option>
                  {(Object.keys(TREN_LABELS) as TrenMuscular[]).map(t => (
                    <option key={t} value={t}>{TREN_LABELS[t]}</option>
                  ))}
                </select>
                <select
                  className="gt-select"
                  style={{ width: 'auto' }}
                  value={filtroObjetivo}
                  onChange={e => setFiltroObjetivo(e.target.value as ObjetivoRutina | '')}
                >
                  <option value="">Todos los objetivos</option>
                  {(Object.keys(OBJETIVO_LABELS) as ObjetivoRutina[]).map(o => (
                    <option key={o} value={o}>{OBJETIVO_LABELS[o]}</option>
                  ))}
                </select>
              </div>

              {/* Cards de plantillas */}
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))', gap: 10 }}>
                {plantillasFiltradas.map(p => (
                  <div
                    key={p.id}
                    onClick={() => aplicarPlantilla(p)}
                    style={{
                      padding: 14,
                      background: '#fff',
                      border: `2px solid ${plantillaSeleccionada?.id === p.id ? '#2E75B6' : '#E5E7EB'}`,
                      borderRadius: 8,
                      cursor: 'pointer',
                      transition: 'border-color 0.15s',
                    }}
                    onMouseEnter={e => { if (plantillaSeleccionada?.id !== p.id) (e.currentTarget as HTMLElement).style.borderColor = '#93C5FD' }}
                    onMouseLeave={e => { if (plantillaSeleccionada?.id !== p.id) (e.currentTarget as HTMLElement).style.borderColor = '#E5E7EB' }}
                  >
                    <div style={{ display: 'flex', gap: 6, marginBottom: 6, flexWrap: 'wrap' }}>
                      <span style={{ fontSize: 11, fontWeight: 700, background: '#EFF6FF', color: '#2E75B6', borderRadius: 4, padding: '2px 6px' }}>
                        {TREN_LABELS[p.trenMuscular]}
                      </span>
                      <span style={{ fontSize: 11, fontWeight: 700, background: '#F0FDF4', color: '#16A34A', borderRadius: 4, padding: '2px 6px' }}>
                        {OBJETIVO_LABELS[p.objetivo]}
                      </span>
                    </div>
                    <p style={{ margin: '0 0 4px', fontWeight: 600, fontSize: 14 }}>{p.nombre}</p>
                    <p style={{ margin: '0 0 8px', fontSize: 12, color: '#6B7280' }}>{p.descripcion}</p>
                    <div style={{ display: 'flex', gap: 12, fontSize: 12, color: '#374151' }}>
                      <span>🏋️ {p.ejercicios.length} ejercicios</span>
                      <span>⏱ {p.duracionEstimada}</span>
                    </div>
                    {plantillaSeleccionada?.id === p.id && (
                      <p style={{ margin: '8px 0 0', fontSize: 12, color: '#2E75B6', fontWeight: 600 }}>✓ Seleccionada</p>
                    )}
                  </div>
                ))}
              </div>
              {plantillasFiltradas.length === 0 && (
                <p style={{ color: '#6B7280', fontSize: 13 }}>No hay plantillas para esa combinación.</p>
              )}
            </div>
          )}
        </div>
      )}

      {/* ── Formulario principal ── */}
      <div className="gt-card">
        {error && (
          <div className="gt-alert gt-alert-error">
            {error}
            <button onClick={() => setError(null)} style={{ float: 'right', background: 'none', border: 'none', cursor: 'pointer' }}>✕</button>
          </div>
        )}

        <form onSubmit={handleSubmit}>
          <div className="gt-form-grid">
            <div className="gt-form-group" style={{ gridColumn: '1 / -1' }}>
              <label className="gt-label">Nombre *</label>
              <input
                className="gt-input"
                value={nombre}
                onChange={e => setNombre(e.target.value)}
                placeholder="Ej: Rutina de fuerza"
                maxLength={50}
                required
              />
            </div>
            <div className="gt-form-group" style={{ gridColumn: '1 / -1' }}>
              <label className="gt-label">Descripción</label>
              <textarea
                className="gt-textarea"
                value={descripcion}
                onChange={e => setDescripcion(e.target.value)}
                placeholder="Objetivo y contenido de la rutina..."
                maxLength={500}
                rows={3}
              />
            </div>
          </div>

          {plantillaSeleccionada && (
            <div style={{ marginBottom: 16, padding: 12, background: '#F0FDF4', borderRadius: 6, border: '1px solid #BBF7D0' }}>
              <p style={{ margin: '0 0 6px', fontWeight: 600, fontSize: 13, color: '#16A34A' }}>
                ✓ Se agregarán {plantillaSeleccionada.ejercicios.length} ejercicios automáticamente:
              </p>
              {plantillaSeleccionada.ejercicios.map((ej, i) => (
                <p key={i} style={{ margin: '2px 0', fontSize: 12, color: '#374151' }}>
                  {i + 1}. {ej.nombreEjercicio} — {ej.series} × {ej.repeticiones} reps · descanso {ej.descansoSeg}s
                </p>
              ))}
            </div>
          )}

          {progreso && (
            <div className="gt-alert" style={{ background: '#EFF6FF', borderColor: '#BFDBFE', color: '#1D4ED8', marginBottom: 12 }}>
              {progreso}
            </div>
          )}

          <div style={{ display: 'flex', gap: 8 }}>
            <button type="submit" className="gt-btn gt-btn-primary" disabled={guardando}>
              {guardando ? (progreso ?? 'Guardando...') : esEdicion ? 'Actualizar' : 'Crear Rutina'}
            </button>
            <button type="button" className="gt-btn gt-btn-secondary" onClick={() => navigate('/rutinas')}>
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </>
  )
}
