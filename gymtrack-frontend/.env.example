# Copiar a .env.local solo si hace falta cambiar algo.

# Desarrollo: NO definir VITE_API_URL. El frontend llama a /api y Vite lo reenvía al backend.
# Backend al que reenvía Vite en desarrollo (por defecto http://localhost:8080)
# VITE_PROXY_TARGET=http://localhost:8080

# Producción (Vercel → Settings → Environment Variables):
# VITE_API_URL=https://<tu-backend>.onrender.com
